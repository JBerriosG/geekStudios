---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Home" theme="home">
  <Nav activePage="home" />

  <!-- ===== HERO ===== -->
  <section class="w-full bg-[var(--gs-bg)]">
    <div class="gs-container">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-10 py-12 sm:py-16 lg:py-0 lg:min-h-[610px]">

        <!-- Copy -->
        <div class="w-full lg:max-w-[640px] xl:max-w-[700px]">
          <p class="gs-section-eyebrow !pt-0">
            ESTUDIO DIGITAL MULTIDISCIPLINARIO
          </p>
          <h1 class="text-4xl sm:text-5xl lg:text-[58px] xl:text-[68px] font-bold leading-[1.1] text-[var(--gs-text-primary)] mb-6 sm:mb-8">
            Creamos.<br />
            Desarrollamos.<br />
            Transformamos.
          </h1>
          <p class="text-base sm:text-lg xl:text-xl text-[var(--gs-text-muted)] leading-relaxed mb-8 sm:mb-10 lg:mb-12 max-w-[540px]">
            Soluciones digitales que combinan desarrollo web, creacion 3D y ciberseguridad.
          </p>
          <a href="#servicios" class="gs-btn bg-[var(--gs-accent)] text-white" id="hero-btn">
            CONOCE GEEK STUDIO
          </a>
        </div>

        <!-- Visual -->
        <div class="relative w-full sm:max-w-[420px] sm:mx-auto lg:mx-0 lg:w-[480px] lg:min-w-[480px] aspect-[480/470] bg-[var(--gs-hero-visual)] rounded-3xl overflow-hidden lg:my-[70px]">
          <div class="absolute w-[65%] aspect-square rounded-full border border-white/20 top-[15%] left-[22%]"></div>
          <span class="absolute font-bold text-white leading-none tracking-[-2px]"
            style="font-size: clamp(2.5rem, 8vw, 4.375rem); top: 33%; left: 13%;">
            GEEK
          </span>
          <span class="absolute font-bold text-white tracking-[3px]"
            style="font-size: clamp(0.875rem, 2.5vw, 1.4375rem); top: 54%; left: 38%;">
            STUDIO
          </span>
        </div>

      </div>
    </div>
  </section>

  <!-- ===== SERVICIOS ===== -->
  <section id="servicios" class="w-full bg-[var(--gs-bg-alt)]">
    <div class="gs-container pb-12 sm:pb-14 xl:pb-[72px]">
      <p class="gs-section-eyebrow">SERVICIOS</p>
      <h2 class="gs-section-heading">
        Dos disciplinas.<br />Una misma vision.
      </h2>
      <p class="gs-section-subtext">
        Cada division de Geek Studio nace para resolver una parte distinta del desafio digital.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 xl:gap-6">

        <a href="/web" class="gs-card">
          <span class="text-[13px] font-bold text-[var(--gs-card-num)]">01</span>
          <span class="text-xl sm:text-2xl xl:text-[27px] font-bold text-[var(--gs-text-primary)] mt-1">WEB</span>
          <p class="text-sm sm:text-[15px] xl:text-[16px] text-[var(--gs-text-muted)] leading-relaxed flex-1">
            Sitios web, landing pages y aplicaciones modernas orientadas a resultados.
          </p>
          <span class="text-[12px] font-bold text-[var(--gs-card-link)] mt-2">EXPLORAR &rarr;</span>
        </a>

        <a href="/3d" class="gs-card">
          <span class="text-[13px] font-bold text-[var(--gs-card-num)]">02</span>
          <span class="text-xl sm:text-2xl xl:text-[27px] font-bold text-[var(--gs-text-primary)] mt-1">3D</span>
          <p class="text-sm sm:text-[15px] xl:text-[16px] text-[var(--gs-text-muted)] leading-relaxed flex-1">
            Modelado para impresion 3D y game assets, renders fotorrealistas y apps de realidad aumentada a medida.
          </p>
          <span class="text-[12px] font-bold text-[var(--gs-card-link)] mt-2">EXPLORAR &rarr;</span>
        </a>

        <!--<a href="/cybersecurity" class="gs-card sm:col-span-2 lg:col-span-1">
          <span class="text-[13px] font-bold text-[var(--gs-card-num)]">03</span>
          <span class="text-xl sm:text-2xl xl:text-[27px] font-bold text-[var(--gs-text-primary)] mt-1">CYBERSECURITY</span>
          <p class="text-sm sm:text-[15px] xl:text-[16px] text-[var(--gs-text-muted)] leading-relaxed flex-1">
            Servicios y soluciones para fortalecer la seguridad digital.
          </p>
          <span class="text-[12px] font-bold text-[var(--gs-card-link)] mt-2">EXPLORAR &rarr;</span>
        </a>-->

      </div>
    </div>
  </section>

  <!-- ===== CONTACTO ===== -->
  <section id="contacto" class="w-full bg-[var(--gs-contact-bg)]">
    <div class="gs-container pb-12 sm:pb-16 xl:pb-20">
      <div class="flex flex-col lg:flex-row lg:justify-between lg:items-start gap-10 lg:gap-20">

        <!-- Copy -->
        <div class="w-full lg:max-w-[720px]">
          <p class="text-[13px] sm:text-[14px] font-semibold tracking-[1.5px] text-white/55 pt-10 sm:pt-12 xl:pt-14 mb-5 sm:mb-7">
            CONTACTO
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-[46px] xl:text-[54px] font-bold leading-[1.15] text-white mb-5 sm:mb-6">
            Hablemos de tu<br />proximo proyecto.
          </h2>
          <p class="text-base sm:text-lg text-white/60 leading-relaxed mb-8 sm:mb-10 lg:mb-12 max-w-[580px]">
            Cuentanos que necesitas y construyamos una solucion a tu medida.
          </p>
          <a href="mailto:jberriosgallo@gmail.com" class="gs-btn bg-[var(--gs-contact-btn)] text-[var(--gs-contact-btn-text)]">
            INICIAR PROYECTO
          </a>
        </div>

        <!-- Info -->
        <div class="flex flex-row flex-wrap lg:flex-col gap-8 lg:gap-7 lg:pt-14 lg:min-w-[200px]">
          <div class="flex flex-col gap-1.5">
            <span class="text-[11px] font-bold tracking-[1.5px] text-white/40">EMAIL</span>
            <a href="mailto:jberriosgallo@gmail.com" class="text-base sm:text-xl font-medium text-white hover:opacity-75 transition-opacity">
              jberriosgallo@gmail.com
            </a>
          </div>
          <div class="flex flex-col gap-1.5">
            <span class="text-[11px] font-bold tracking-[1.5px] text-white/40">INSTAGRAM</span>
            <a href="https://instagram.com/geekstudio" target="_blank" rel="noopener"
               class="text-base sm:text-xl font-medium text-white hover:opacity-75 transition-opacity">
              @geekstudio
            </a>
          </div>
          <div class="flex flex-col gap-1.5">
            <span class="text-[11px] font-bold tracking-[1.5px] text-white/40">CHILE</span>
            <span class="text-base sm:text-xl font-medium text-white">Santiago &middot; Chile</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="w-full bg-[var(--gs-bg)] border-t border-[var(--gs-accent)]/12">
    <div class="gs-container h-16 sm:h-[100px] flex items-center justify-between">
      <span class="text-sm sm:text-[16px] font-bold text-[var(--gs-footer-text)] tracking-wide">
        GEEK STUDIO
      </span>
      <span class="text-xs sm:text-[13px] text-[var(--gs-footer-copy)]">
        &copy; 2026 Geek Studio
      </span>
    </div>
  </footer>
</Layout>