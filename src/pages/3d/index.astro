---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
---

<Layout title="3D" theme="3d">
  <Nav activePage="3d" />

  <!-- ===== HERO ===== -->
  <section class="w-full bg-[var(--gs-bg-alt)]">
    <div class="gs-container">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-10 py-12 sm:py-16 lg:py-0 lg:min-h-[610px]">

        <!-- Copy -->
        <div class="w-full lg:max-w-[640px] xl:max-w-[700px]">
          <p class="gs-section-eyebrow !pt-0">GEEK STUDIO · 3D</p>
          <h1 class="text-4xl sm:text-5xl lg:text-[58px] xl:text-[68px] font-bold leading-[1.1] text-[var(--gs-text-primary)] mb-6 sm:mb-8">
            Objetos digitales que<br />cobran vida.
          </h1>
          <p class="text-base sm:text-lg xl:text-xl text-[var(--gs-text-muted)] leading-relaxed mb-8 sm:mb-10 lg:mb-12 max-w-[540px]">
            Modelado, visualización y experiencias 3D que elevan tu marca a otra dimensión.
          </p>
          <a href="#contacto" class="gs-btn bg-[var(--gs-accent)] text-[var(--gs-badge-text)]">
            VER PROYECTOS 3D
          </a>
        </div>

        <!-- Cube visual -->
        <div
          class="cube-scene w-full sm:max-w-[420px] sm:mx-auto lg:mx-0 lg:w-[480px] lg:min-w-[480px] aspect-[480/470] bg-[var(--gs-hero-visual)] rounded-3xl overflow-hidden flex items-center justify-center lg:my-[70px]"
        >
          <div class="cube-wrapper">
            <div class="cube-box">
              <div class="cube-face cube-front"></div>
              <div class="cube-face cube-back"></div>
              <div class="cube-face cube-right"></div>
              <div class="cube-face cube-left"></div>
              <div class="cube-face cube-top"></div>
              <div class="cube-face cube-bottom"></div>
            </div>
          </div>
          <span class="absolute bottom-6 left-6 sm:bottom-10 sm:left-8 text-[clamp(2.5rem,10vw,5rem)] font-bold text-white/15 tracking-[-3px] pointer-events-none select-none">3D</span>
          <span class="absolute bottom-8 right-6 sm:bottom-12 sm:right-8 text-sm sm:text-xl font-bold text-white/25 tracking-[3px] pointer-events-none select-none">STUDIO</span>
        </div>

        <style>
          /* Tamaño del cubo por breakpoint — translateZ = lado / 2 */
          :root {
            --cube-size: 140px;
            --cube-half: 70px;
          }
          @media (min-width: 640px) {
            :root {
              --cube-size: 180px;
              --cube-half: 90px;
            }
          }
          @media (min-width: 1024px) {
            :root {
              --cube-size: 200px;
              --cube-half: 100px;
            }
          }

          .cube-scene {
            position: relative;
            perspective: 600px;
          }

          .cube-wrapper {
            width: var(--cube-size);
            height: var(--cube-size);
          }

          .cube-box {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            animation: rotateCube 12s infinite linear;
          }

          .cube-face {
            position: absolute;
            width: var(--cube-size);
            height: var(--cube-size);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.05);
          }

          .cube-front  { transform: translateZ(var(--cube-half)); }
          .cube-back   { transform: rotateY(180deg) translateZ(var(--cube-half)); }
          .cube-right  { transform: rotateY(90deg)  translateZ(var(--cube-half)); }
          .cube-left   { transform: rotateY(-90deg) translateZ(var(--cube-half)); }
          .cube-top    { transform: rotateX(90deg)  translateZ(var(--cube-half)); }
          .cube-bottom { transform: rotateX(-90deg) translateZ(var(--cube-half)); }
        </style>

      </div>
    </div>
  </section>

  <!-- ===== SERVICIOS ===== -->
  <section id="servicios" class="w-full bg-[var(--gs-bg)]">
    <div class="gs-container pb-12 sm:pb-14 xl:pb-[72px]">
      <p class="gs-section-eyebrow">SERVICIOS 3D</p>
      <h2 class="gs-section-heading">Diseño tridimensional<br />para el mundo digital.</h2>
      <p class="gs-section-subtext">
        Desde visualizaciones de producto hasta entornos inmersivos, creamos experiencias 3D que sorprenden.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 xl:gap-6">
        <div class="gs-card">
          <span class="text-[13px] font-bold text-[var(--gs-card-num)]">01</span>
          <span class="text-xl sm:text-2xl xl:text-[25px] font-bold text-[var(--gs-text-primary)] mt-1">MODELADO 3D</span>
          <p class="text-sm sm:text-[15px] xl:text-[16px] text-[var(--gs-text-muted)] leading-relaxed flex-1">
            Creamos modelos 3D de alta precisión optimizados para impresión 3D y game assets, listos para producción o integración en motores como Unity y Unreal.
          </p>
          <span class="text-[12px] font-bold text-[var(--gs-card-link)] mt-2">VER SERVICIO →</span>
        </div>
        <div class="gs-card">
          <span class="text-[13px] font-bold text-[var(--gs-card-num)]">02</span>
          <span class="text-xl sm:text-2xl xl:text-[25px] font-bold text-[var(--gs-text-primary)] mt-1">RENDERS FOTORREALISTAS</span>
          <p class="text-sm sm:text-[15px] xl:text-[16px] text-[var(--gs-text-muted)] leading-relaxed flex-1">
            Visualizaciones de alta fidelidad para proyectos arquitectónicos y presentación de productos, con iluminación y materiales que replican la realidad con precisión.
          </p>
          <span class="text-[12px] font-bold text-[var(--gs-card-link)] mt-2">VER SERVICIO →</span>
        </div>
        <div class="gs-card sm:col-span-2 lg:col-span-1">
          <span class="text-[13px] font-bold text-[var(--gs-card-num)]">03</span>
          <span class="text-xl sm:text-2xl xl:text-[25px] font-bold text-[var(--gs-text-primary)] mt-1">REALIDAD AUMENTADA</span>
          <p class="text-sm sm:text-[15px] xl:text-[16px] text-[var(--gs-text-muted)] leading-relaxed flex-1">
            Desarrollamos apps AR con modelos 3D creados a medida para tu negocio. Ideal para retail, gastronomía y cualquier rubro que quiera llevar su producto al espacio del cliente.
          </p>
          <span class="text-[12px] font-bold text-[var(--gs-card-link)] mt-2">VER SERVICIO →</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CONTACTO ===== -->
  <section id="contacto" class="w-full bg-[var(--gs-contact-bg)]">
    <div class="gs-container pb-12 sm:pb-16 xl:pb-20">
      <div class="flex flex-col lg:flex-row lg:justify-between lg:items-start gap-10 lg:gap-20">
        <div class="w-full lg:max-w-[720px]">
          <p class="text-[13px] sm:text-[14px] font-semibold tracking-[1.5px] text-white/55 pt-10 sm:pt-12 xl:pt-14 mb-5 sm:mb-7">
            CONTACTO
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-[44px] xl:text-[52px] font-bold leading-[1.15] text-white mb-5 sm:mb-6">
            ¿Listo para dar vida<br />a tu proyecto en 3D?
          </h2>
          <p class="text-base sm:text-lg text-white/60 leading-relaxed mb-8 sm:mb-10 lg:mb-12 max-w-[580px]">
            Cuéntanos tu idea y creamos la experiencia visual que imaginas.
          </p>
          <a href="mailto:jberriosgallo@gmail.com" class="gs-btn bg-[var(--gs-contact-btn)] text-[var(--gs-contact-btn-text)]">
            HABLEMOS
          </a>
        </div>
        <div class="flex flex-row flex-wrap lg:flex-col gap-8 lg:gap-7 lg:pt-14 lg:min-w-[200px]">
          <div class="flex flex-col gap-1.5">
            <span class="text-[11px] font-bold tracking-[1.5px] text-white/40">EMAIL</span>
            <a href="mailto:jberriosgallo@gmail.com" class="text-base sm:text-xl font-medium text-white hover:opacity-75 transition-opacity">
              jberriosgallo@gmail.com
            </a>
          </div>
          <div class="flex flex-col gap-1.5">
            <span class="text-[11px] font-bold tracking-[1.5px] text-white/40">INSTAGRAM</span>
            <a href="https://instagram.com/geek_studios_web" target="_blank" rel="noopener" class="text-base sm:text-xl font-medium text-white hover:opacity-75 transition-opacity">
              @geek_studios_web
            </a>
          </div>
          <div class="flex flex-col gap-1.5">
            <span class="text-[11px] font-bold tracking-[1.5px] text-white/40">SERVICIO</span>
            <span class="text-base sm:text-xl font-medium text-white">Diseño 3D</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="w-full bg-[var(--gs-bg-alt)] border-t border-[var(--gs-accent)]/12">
    <div class="gs-container h-16 sm:h-[100px] flex items-center justify-between">
      <span class="text-sm sm:text-[16px] font-bold text-[var(--gs-footer-text)] tracking-wide">GEEK STUDIO · 3D</span>
      <span class="text-xs sm:text-[13px] text-[var(--gs-footer-copy)]">© 2026 Geek Studio</span>
    </div>
  </footer>
</Layout>