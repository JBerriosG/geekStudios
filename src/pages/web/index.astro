---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
---

<Layout title="Web" theme="web">
  <Nav activePage="web" />

  <!-- ===== HERO ===== -->
  <section class="w-full bg-[var(--gs-bg-alt)]">
    <div class="gs-container">
      <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-10 py-12 sm:py-16 lg:py-0 lg:min-h-[610px]">

        <!-- Copy -->
        <div class="w-full lg:max-w-[640px] xl:max-w-[700px]">
          <p class="gs-section-eyebrow !pt-0">GEEK STUDIO · WEB</p>
          <h1 class="text-4xl sm:text-5xl lg:text-[58px] xl:text-[68px] font-bold leading-[1.1] text-[var(--gs-text-primary)] mb-6 sm:mb-8">
            Tu presencia digital<br />empieza aquí.
          </h1>
          <p class="text-base sm:text-lg xl:text-xl text-[var(--gs-text-muted)] leading-relaxed mb-8 sm:mb-10 lg:mb-12 max-w-[540px]">
            Diseñamos y desarrollamos sitios web modernos, rápidos y preparados para convertir visitas en clientes.
          </p>
          <a href="#contacto" class="gs-btn bg-[var(--gs-accent)] text-[var(--gs-badge-text)]">
            CREAR MI PROYECTO
          </a>
        </div>

        <!-- Browser mockup visual -->
        <div class="w-full sm:max-w-[420px] sm:mx-auto lg:mx-0 lg:w-[480px] lg:min-w-[480px] aspect-[480/470] bg-[var(--gs-hero-visual)] rounded-3xl overflow-hidden flex items-center justify-center lg:my-[70px]">
          <div class="w-[80%] max-w-[390px] bg-white rounded-xl overflow-hidden shadow-2xl">
            <div class="h-9 sm:h-10 bg-gray-100 flex items-center px-3 sm:px-4 gap-2 sm:gap-3">
              <div class="flex gap-1 sm:gap-1.5">
                <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-gray-300"></span>
                <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-gray-300"></span>
                <span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-gray-300"></span>
              </div>
              <div class="flex-1 h-4 sm:h-5 bg-gray-200 rounded-full"></div>
            </div>
            <div class="p-4 sm:p-5 flex flex-col gap-2 sm:gap-3">
              <div class="h-3 w-[70%] bg-gray-200 rounded-full"></div>
              <div class="h-2.5 w-1/2 bg-gray-200 rounded-full"></div>
              <div class="grid grid-cols-3 gap-2 mt-1">
                <div class="h-14 sm:h-20 rounded-lg" style="background-color: color-mix(in srgb, var(--gs-accent) 15%, white);"></div>
                <div class="h-14 sm:h-20 rounded-lg" style="background-color: color-mix(in srgb, var(--gs-accent) 15%, white);"></div>
                <div class="h-14 sm:h-20 rounded-lg" style="background-color: color-mix(in srgb, var(--gs-accent) 15%, white);"></div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===== SERVICIOS ===== -->
  <section id="servicios" class="w-full bg-[var(--gs-bg)]">
    <div class="gs-container pb-12 sm:pb-14 xl:pb-[72px]">
      <p class="gs-section-eyebrow">SERVICIOS WEB</p>
      <h2 class="gs-section-heading">Construimos experiencias<br />digitales que funcionan.</h2>
      <p class="gs-section-subtext">
        Desde una landing hasta una aplicación web, desarrollamos soluciones adaptadas a tu negocio.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 xl:gap-6">
        <div class="gs-card">
          <span class="text-[13px] font-bold text-[var(--gs-card-num)]">01</span>
          <span class="text-xl sm:text-2xl xl:text-[25px] font-bold text-[var(--gs-text-primary)] mt-1">LANDING PAGES</span>
          <p class="text-sm sm:text-[15px] xl:text-[16px] text-[var(--gs-text-muted)] leading-relaxed flex-1">
            Páginas de aterrizaje modernas, responsive y enfocadas en presentar tu negocio.
          </p>
          <span class="text-[12px] font-bold text-[var(--gs-card-link)] mt-2">VER SERVICIO →</span>
        </div>
        <div class="gs-card">
          <span class="text-[13px] font-bold text-[var(--gs-card-num)]">02</span>
          <span class="text-xl sm:text-2xl xl:text-[25px] font-bold text-[var(--gs-text-primary)] mt-1">SITIOS WEB</span>
          <p class="text-sm sm:text-[15px] xl:text-[16px] text-[var(--gs-text-muted)] leading-relaxed flex-1">
            Sitios corporativos y comerciales con una experiencia clara y profesional.
          </p>
          <span class="text-[12px] font-bold text-[var(--gs-card-link)] mt-2">VER SERVICIO →</span>
        </div>
        <div class="gs-card sm:col-span-2 lg:col-span-1">
          <span class="text-[13px] font-bold text-[var(--gs-card-num)]">03</span>
          <span class="text-xl sm:text-2xl xl:text-[25px] font-bold text-[var(--gs-text-primary)] mt-1">APLICACIONES WEB</span>
          <p class="text-sm sm:text-[15px] xl:text-[16px] text-[var(--gs-text-muted)] leading-relaxed flex-1">
            Aplicaciones web a medida e integraciones para digitalizar procesos.
          </p>
          <span class="text-[12px] font-bold text-[var(--gs-card-link)] mt-2">VER SERVICIO →</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CONTACTO ===== -->
  <section id="contacto" class="w-full bg-[var(--gs-contact-bg)]">
    <div class="gs-container pb-12 sm:pb-16 xl:pb-20">
      <div class="flex flex-col lg:flex-row lg:justify-between lg:items-start gap-10 lg:gap-20">
        <div class="w-full lg:max-w-[720px]">
          <p class="text-[13px] sm:text-[14px] font-semibold tracking-[1.5px] text-white/55 pt-10 sm:pt-12 xl:pt-14 mb-5 sm:mb-7">
            CONTACTO
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-[44px] xl:text-[52px] font-bold leading-[1.15] text-white mb-5 sm:mb-6">
            ¿Tienes una idea para<br />tu próximo sitio web?
          </h2>
          <p class="text-base sm:text-lg text-white/60 leading-relaxed mb-8 sm:mb-10 lg:mb-12 max-w-[580px]">
            Cuéntanos sobre tu proyecto y conversemos sobre cómo llevarlo a la web.
          </p>
          <a href="mailto:jberriosgallo@gmail.com" class="gs-btn bg-[var(--gs-contact-btn)] text-[var(--gs-contact-btn-text)]">
            HABLEMOS
          </a>
        </div>
        <div class="flex flex-row flex-wrap lg:flex-col gap-8 lg:gap-7 lg:pt-14 lg:min-w-[200px]">
          <div class="flex flex-col gap-1.5">
            <span class="text-[11px] font-bold tracking-[1.5px] text-white/40">EMAIL</span>
            <a href="mailto:jberriosgallo@gmail.com" class="text-base sm:text-xl font-medium text-white hover:opacity-75 transition-opacity">
              jberriosgallo@gmail.com
            </a>
          </div>
          <div class="flex flex-col gap-1.5">
            <span class="text-[11px] font-bold tracking-[1.5px] text-white/40">INSTAGRAM</span>
            <a href="https://instagram.com/geekstudio" target="_blank" rel="noopener" class="text-base sm:text-xl font-medium text-white hover:opacity-75 transition-opacity">
              @geek_studio_web
            </a>
          </div>
          <div class="flex flex-col gap-1.5">
            <span class="text-[11px] font-bold tracking-[1.5px] text-white/40">SERVICIO</span>
            <span class="text-base sm:text-xl font-medium text-white">Desarrollo Web</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="w-full bg-[var(--gs-bg)] border-t border-[var(--gs-accent)]/12">
    <div class="gs-container h-16 sm:h-[100px] flex items-center justify-between">
      <span class="text-sm sm:text-[16px] font-bold text-[var(--gs-footer-text)] tracking-wide">GEEK STUDIO · WEB</span>
      <span class="text-xs sm:text-[13px] text-[var(--gs-footer-copy)]">© 2026 Geek Studio</span>
    </div>
  </footer>
</Layout>